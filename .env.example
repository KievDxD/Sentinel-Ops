# ==============================================================================
# SENTINEL // OPS — ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Versión: Enterprise V3.5 (SaaS B2B Seguridad Privada Colombia)
# ==============================================================================

# Entorno de Ejecución (desarrollo / produccion)
ENTORNO=produccion
DEBUG=False
MODO_MULTI_TENANT=True
TENANT_ID_PREDETERMINADO=EMPRESA-SEGURIDAD-COLOMBIA-01

# URLs Base y Seguridad CORS (Permitir frontend en Docker o Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Base de Datos PostgreSQL 15 (Producción Docker)
URL_BASE_DATOS_POSTGRES=postgresql+asyncpg://administrador_sentinel:clave_segura_sentinel_2026@postgres:5432/sentinel_ops_bd

# Base de Datos SQLite (Respaldo local asíncrono para contingencias)
URL_BASE_DATOS_RESPALDO=sqlite+aiosqlite:///./sentinel_ops_local.db

# Parámetros Criptográficos JWT (HMAC SHA-256)
CLAVE_SECRETA_JWT=sentinel_ops_clave_maestra_2026_seguridad_privada_colombia_hmac_sha256
ALGORITMO_JWT=HS256
MINUTOS_EXPIRACION_ACCESO=120
DIAS_EXPIRACION_REFRESCO=7

# Marco Laboral Colombiano (Ley 2101 de 2021, Ley 1920 de 2018 y Código Sustantivo del Trabajo)
SMLMV_VIGENTE=1423500.0
AUXILIO_TRANSPORTE_VIGENTE=200000.0
TOPE_HORAS_SEMANALES=42
HORA_INICIO_NOCTURNO=21
HORA_FIN_NOCTURNO=6
HORAS_JORNADA_ORDINARIA_TURNO=8.0
HORAS_DESCANSO_MINIMO_ENTRE_TURNOS=12.0
VALOR_HORA_ORDINARIA_COP=6500.0
FACTOR_RECARGO_NOCTURNO=0.35
FACTOR_HORA_EXTRA_DIURNA=1.25
FACTOR_HORA_EXTRA_NOCTURNA=1.75
FACTOR_RECARGO_DOMINICAL_FESTIVO=0.75

